<Window x:Class="pr8.Accountant"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr8"
        mc:Ignorable="d"
        Title="Бухгалтер – АИСУ «Гига»" Height="500" Width="800" Background="#FF655D90" BorderBrush="Transparent">
    <Grid>
        <TabControl  Background="#FF655D90" BorderBrush="Transparent">
            <TabItem Header="Бюджет проектов" Background="#FFFF981A">
                <Grid Background="#FF655D90" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Content="Выберите проект:" VerticalContentAlignment="Center" Foreground="White" Grid.Row="0" Grid.Column="0" Margin="5"/>
                    <ComboBox Grid.Row="0" VerticalContentAlignment="Center" FontSize="14" Grid.Column="1" Margin="5" Height="30" x:Name="cbProjectBudget"/>
                    <Label Content="Бюджет (руб.):" VerticalContentAlignment="Center" Foreground="White" Grid.Row="2" Grid.Column="0" Margin="5"/>
                    <TextBox Grid.Row="2" VerticalContentAlignment="Center" FontSize="14" Grid.Column="1" Margin="5" Height="30" x:Name="tbNewBudget"/>
                    <Button Content="Указать бюджет" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left"
                            Width="140" Height="35" Background="#FFFF981A" Foreground="White"
                            Margin="5,10,0,0" x:Name="btnSetBudget" Click="btnSetBudget_Click"/>
                    <Button Content="Выйти" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left"
                        Width="73" Height="35" Background="#FF4E4E" Foreground="White"
                        Margin="156,10,0,0" x:Name="btnExit" />
                </Grid>
            </TabItem>
            <TabItem Header="Сметы" Background="#FFFF981A">
                <Grid Background="#FF655D90" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Content="Проект:" VerticalContentAlignment="Center" Foreground="White" Grid.Row="0" Grid.Column="0" Margin="5"/>
                    <ComboBox Grid.Row="0" VerticalContentAlignment="Center" FontSize="14" Grid.Column="1" Margin="5" Height="30" x:Name="cbProjectEstimate"/>
                    <Label Content="Название сметы:" VerticalContentAlignment="Center"  Foreground="White" Grid.Row="1" Grid.Column="0" Margin="5"/>
                    <TextBox Grid.Row="1" VerticalContentAlignment="Center" FontSize="14" Grid.Column="1" Margin="5" Height="30" x:Name="tbEstimateName"/>
                    <Label Content="Сумма (руб.):" VerticalContentAlignment="Center" Foreground="White" Grid.Row="2" Grid.Column="0" Margin="5"/>
                    <TextBox Grid.Row="2" VerticalContentAlignment="Center" FontSize="14" Grid.Column="1" Margin="5" Height="30" x:Name="tbEstimateAmount"/>
                    <Label Content="Статья расходов:" VerticalContentAlignment="Center" Foreground="White" Grid.Row="3" Grid.Column="0" Margin="5"/>
                    <ComboBox Grid.Row="3" VerticalContentAlignment="Center" FontSize="14" Grid.Column="1" Margin="5" Height="30" x:Name="cbExpenseCategory">
                        <ComboBoxItem Content="Оборудование"/>
                        <ComboBoxItem Content="Заработная плата"/>
                        <ComboBoxItem Content="Лицензии ПО"/>
                        <ComboBoxItem Content="Прочее"/>
                    </ComboBox>
                    <Button Content="Добавить смету" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left"
                            Width="140" Height="35" Background="#FFFF981A" Foreground="White"
                            Margin="5,10,0,0" x:Name="btnAddEstimate" Click="btnAddEstimate_Click"/>
                    <Button Content="Закрыть" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left"
                        Width="77" Height="35" Background="#FF4E4E" Foreground="White"
                        Margin="161,10,0,0" x:Name="btnArchiveProject_Копировать1" />
                </Grid>
            </TabItem>
            <TabItem Header="Кадры" Background="#FFFF981A">
                <Grid Background="#FF655D90" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="0"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="0*"/>
                    </Grid.RowDefinitions>
                    <Label Content="Список сотрудников:" Foreground="White" Grid.Row="0" Grid.Column="0" Margin="5,5,5,5"/>
                    <DataGrid Grid.Row="1" Grid.Column="0" AutoGenerateColumns="False" Background="White" x:Name="dgEmployees"
                              Margin="5,0,85,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Фамилия" Width="100"/>
                            <DataGridTextColumn Header="Имя" Width="100"/>
                            <DataGridTextColumn Header="Отчество" Width="100"/>
                            <DataGridTextColumn Header="Роль" Width="120"/>
                            <DataGridTextColumn Header="Проект" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,-10,0" VerticalAlignment="Top" Height="0"/>
                    <Button Content="Выйти" x:Name="btnExit1" Background="#FF4E4E" Foreground="White" HorizontalAlignment="Left" Margin="694,353,0,0" Grid.Row="1" VerticalAlignment="Top" Height="29" Width="63"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
