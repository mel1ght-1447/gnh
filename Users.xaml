<Window x:Class="pr8.Users"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr8"
        mc:Ignorable="d"
         Title="Управление пользователями" Height="550" Width="700" Background="#FF655D90" BorderBrush="Transparent">
    <Grid>
        <TabControl Background="#FF655D90" BorderBrush="Transparent">
            <TabItem Header="Создать учётную запись" Background="#FFFF981A">
                <Grid Background="#FF655D90" Margin="0,0,-1,0" Height="507">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Content="Фамилия:" Foreground="White" Grid.Row="0" Grid.Column="0" Margin="5" VerticalContentAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="5" Height="30" x:Name="tbLastname" VerticalContentAlignment="Center" FontSize="14"/>
                    <Label Content="Имя:" Foreground="White" Grid.Row="1" Grid.Column="0" Margin="5" VerticalContentAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="5" Height="30" x:Name="tbFirstname" VerticalContentAlignment="Center" FontSize="14"/>
                    <Label Content="Отчество:" Foreground="White" Grid.Row="2" Grid.Column="0" Margin="5" VerticalContentAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="5" Height="30" x:Name="tbMiddlename" VerticalContentAlignment="Center" FontSize="14"/>
                    <Label Content="Логин:" Foreground="White" Grid.Row="3" Grid.Column="0" Margin="5" VerticalContentAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="5" Height="30" x:Name="tbLogin" VerticalContentAlignment="Center" FontSize="14"/>
                    <Label Content="Пароль:" Foreground="White" Grid.Row="4" Grid.Column="0" Margin="5" VerticalContentAlignment="Center"/>
                    <TextBox Grid.Row="4" x:Name="tbPassword" Grid.Column="1" Margin="5" Height="30" VerticalContentAlignment="Center" FontSize="14"/>
                    <Label Content="Телефон:" Foreground="White" Grid.Row="5" Grid.Column="0" Margin="5" VerticalContentAlignment="Center"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Margin="5" Height="30" x:Name="tbPhoneNumber" VerticalContentAlignment="Center" FontSize="14"/>
                    <Label Content="Email:" Foreground="White" Grid.Row="6" Grid.Column="0" Margin="5" VerticalContentAlignment="Center"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Margin="5" Height="30" x:Name="tbEmail" VerticalContentAlignment="Center"/>
                    <Label Content="Роль:" Foreground="White" Grid.Row="7" Grid.Column="0" Margin="5" VerticalContentAlignment="Center"/>
                    <ComboBox Grid.Row="7" Grid.Column="1" Margin="5" Height="30" x:Name="cbRole" VerticalContentAlignment="Center" FontSize="14">
                        <ComboBoxItem Content="Administrator"/>
                        <ComboBoxItem Content="Accountant"/>
                        <ComboBoxItem Content="Programmer"/>
                        <ComboBoxItem Content="Manager"/>
                    </ComboBox>
                    <Button Content="Сохранить" Grid.Row="8" Grid.Column="1" HorizontalAlignment="Left"
                            Width="100" Height="35" Background="#FFFF981A" Foreground="White"
                            Margin="5,10,0,0" x:Name="btnCreateUser" Click="btnCreateUser_Click"/>
                    <Button Content="Выйти" Grid.Row="8" Grid.Column="1" HorizontalAlignment="Left"
                        Width="120" Height="35" Background="#FF4E4E" Foreground="White"
                        Margin="120,10,0,0" x:Name="btnClose"/>
                </Grid>
            </TabItem>
            <TabItem Header="Редактировать учётную запись" Background="#FFFF981A">
                <Grid Background="#FF655D90" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="162"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Content="Выберите пользователя:" Foreground="White" Grid.Row="0" Grid.Column="0" Margin="5,5,5,5" VerticalContentAlignment="Center"/>
                    <ComboBox Grid.Row="0" VerticalContentAlignment="Center" FontSize="14" Grid.Column="1" Margin="5,5,5,5" x:Name="cbUsersEdit" SelectionChanged="cbUsersEdit_SelectionChanged"/>
                    <Label Content="Фамилия:" Foreground="White" Grid.Row="1" Grid.Column="0" Margin="5,5,5,5" VerticalContentAlignment="Center"/>
                    <TextBox Grid.Row="1" VerticalContentAlignment="Center" FontSize="14" Grid.Column="1" Margin="5,5,5,5" x:Name="tbEditSurname"/>
                    <Label Content="Имя:" Foreground="White" Grid.Row="2" Grid.Column="0" Margin="5,5,5,5" VerticalContentAlignment="Center"/>
                    <TextBox Grid.Row="2" VerticalContentAlignment="Center" FontSize="14" Grid.Column="1" Margin="5,5,5,5" x:Name="tbEditName"/>
                    <Label Content="Отчество:" Foreground="White" Grid.Row="3" Grid.Column="0" Margin="5,5,5,5" VerticalContentAlignment="Center"/>
                    <TextBox Grid.Row="3" VerticalContentAlignment="Center" FontSize="14" Grid.Column="1" Margin="5,5,5,5" x:Name="tbEditPatronymic"/>
                    <Label Content="Логин:" Foreground="White" Grid.Row="4" Grid.Column="0" Margin="5,5,5,5" VerticalContentAlignment="Center"/>
                    <TextBox Grid.Row="4" VerticalContentAlignment="Center" FontSize="14" Grid.Column="1" Margin="5,5,5,5" x:Name="tbEditLogin"/>
                    <Label Content="Пароль:" Foreground="White" Grid.Row="5" Grid.Column="0" Margin="5,5,5,5" VerticalContentAlignment="Center"/>
                    <PasswordBox Grid.Row="5" VerticalContentAlignment="Center" FontSize="14" Grid.Column="1" Margin="5,5,5,5" x:Name="pbEditPassword"/>
                    <Label Content="Телефон:" Foreground="White" Grid.Row="6" Grid.Column="0" Margin="5,5,5,5" VerticalContentAlignment="Center"/>
                    <TextBox Grid.Row="6" VerticalContentAlignment="Center" FontSize="14" Grid.Column="1" Margin="5,5,5,5" x:Name="tbEditPhone"/>
                    <Label Content="Email:" Foreground="White" Grid.Row="7" Grid.Column="0" Margin="5,5,5,5" VerticalContentAlignment="Center"/>
                    <TextBox Grid.Row="7" VerticalContentAlignment="Center" FontSize="14" Grid.Column="1" Margin="5,5,5,5" x:Name="tbEditEmail"/>
                    <Label Content="Роль:" Foreground="White" Grid.Row="8" Grid.Column="0" Margin="5,5,5,5" VerticalContentAlignment="Center"/>
                    <ComboBox Grid.Row="8" VerticalContentAlignment="Center" FontSize="14" Grid.Column="1" Margin="5,5,5,5" x:Name="cbEditRole"/>
                    <Button Content="Обновить" Grid.Row="9" Grid.Column="1" HorizontalAlignment="Left"
                            Width="115" Background="#FFFF981A" Foreground="White"
                            Margin="10,10,0,-40" x:Name="btnUpdateUser" Click="btnUpdateUser_Click"/>
                    <Button Content="Выйти" Grid.Row="9" Grid.Column="1" HorizontalAlignment="Left"
                        Width="120" Height="35" Background="#FF4E4E" Foreground="White"
                        Margin="136,10,0,-40" x:Name="btnClose2"/>
                </Grid>
            </TabItem>
            <TabItem Header="Удалить учётную запись" Background="#FFFF981A">
                <Grid Background="#FF655D90" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="169"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto" MinHeight="41"/>
                        <RowDefinition Height="Auto" MinHeight="14.96"/>
                    </Grid.RowDefinitions>

                    <Label Content="Выберите пользователя:" Foreground="White" Grid.Row="0" Grid.Column="0" Margin="5,5,5,5" VerticalContentAlignment="Center"/>
                    <ComboBox Grid.Row="0" VerticalContentAlignment="Center" FontSize="14" Grid.Column="1" Margin="19,5,5,5" x:Name="cbUsersDelete"/>
                    <Button Content="Удалить" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left"
                            Width="100" Background="#FF4E4E" Foreground="White"
                            Margin="19,10,0,1" x:Name="btnDeleteUser" Click="btnDeleteUser_Click"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>