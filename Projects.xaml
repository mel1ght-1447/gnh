<Window x:Class="pr8.Projects"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr8"
        mc:Ignorable="d"
        Title="Управление проектами" Height="400" Width="600" Background="#FF655D90" BorderBrush="Transparent">
    <Grid>
        <TabControl Background="#FF655D90" BorderBrush="Transparent">
            <TabItem Header="Архивировать проект" Background="#FFFF981A">
                <Grid Background="#FF655D90" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Content="Проект:" Foreground="White" Grid.Row="0" Grid.Column="0" Margin="5"/>
                    <ComboBox Grid.Row="0" VerticalContentAlignment="Center" FontSize="14" Grid.Column="1" Margin="5" Height="30" x:Name="cbArchiveProject"/>
                    <Button Content="Архивировать" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left"
                            Width="120" Height="35" Background="#FF8C00" Foreground="White"
                            Margin="5,10,0,0" x:Name="btnArchiveProject" />
                    <Button Content="Выйти" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left"
                        Width="120" Height="35" Background="#FF4E4E" Foreground="White"
                        Margin="146,10,0,0" x:Name="btnExit"/>
                </Grid>
            </TabItem>
            <TabItem Header="Восстановить проект" Background="#FFFF981A">
                <Grid Background="#FF655D90" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="181"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="40.03"/>
                        <RowDefinition Height="Auto" MinHeight="29.96"/>
                    </Grid.RowDefinitions>
                    <Label Content="Проект для восстановления:" Foreground="White" Grid.Row="0" Grid.Column="0" Margin="5,5,5,5"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="5,5,5,5" x:Name="cbRestoreProject"/>
                    <Button Content="Восстановить последнюю версию" Grid.Row="1" Grid.Column="1" Background="#FFFF981A" Foreground="White"
                            Margin="66,10,107,-5" x:Name="btnRestoreProject" Click="btnRestoreProject_Click" RenderTransformOrigin="0.32,0.463"/>
                    <Button Content="Выйти" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left"
                        Width="120" Height="35" Background="#FF4E4E" Foreground="White"
                        Margin="248,236,0,-226" x:Name="btnExit1"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>