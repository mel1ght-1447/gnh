<Window x:Class="pr8.SignIn"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr8"
        mc:Ignorable="d"
        Title="Авторизация" Height="300" Width="400" Background="#FF655D90" ResizeMode="NoResize">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="280">
            <TextBlock Text="Вход в систему" FontSize="22" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <Label Content="Логин" Foreground="White"/>
            <TextBox x:Name="tbLogin" VerticalContentAlignment="Center" FontSize="14" Height="30" Margin="0,0,0,10"/>
            <Label Content="Пароль" Foreground="White"/>
            <PasswordBox x:Name="tbPassword" VerticalContentAlignment="Center" FontSize="14" Height="30" Margin="0,0,0,20"/>
            <Button x:Name="btnAuth" Content="Войти" Width="107" Height="35"
                    Background="#FFFF981A" Foreground="White" FontWeight="Bold"
                    Click="btnAuth_Click"/>
            <Button x:Name="btnExit" Content="Выйти" Width="107" Height="35"
                Background="#FF4E4E" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
