<Window x:Class="pr8.Reports"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr8"
        mc:Ignorable="d"
        Title="Отчёты" Height="400" Width="600" Background="#FF655D90" BorderBrush="Transparent">
    <Grid>
        <TabControl Background="#FF655D90" BorderBrush="Transparent">
            <TabItem Header="Создать отчёт" Background="#FFFF981A">
                <Grid Background="#FF655D90" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="178"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="31.96"/>
                    </Grid.RowDefinitions>

                    <Label Content="Название отчёта:" Foreground="White" Grid.Row="0" Grid.Column="0" Margin="5,5,5,5"/>
                    <TextBox Grid.Row="0" VerticalContentAlignment="Center" FontSize="14" Grid.Column="1" Margin="5,5,5,5" x:Name="tbReportName"/>
                    <Label Content="Шаблон:" Foreground="White" Grid.Row="1" Grid.Column="0" Margin="5,5,5,5"/>
                    <ComboBox Grid.Row="1" VerticalContentAlignment="Center" FontSize="14" Grid.Column="1" Margin="5,5,5,5" x:Name="cbTemplate">
                        <ComboBoxItem Content="Табличный отчёт"/>
                        <ComboBoxItem Content="Текстовый отчёт"/>
                    </ComboBox>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="5,5,5,27"/>
                    <Button Content="Создать" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left"
                            Width="100" Background="#FFFF981A" Foreground="White"
                            Margin="5,6,0,-7" x:Name="btnCreateReport" Click="btnCreateReport_Click"/>
                    <Button Content="Выйти" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left"
                        Width="82" Background="#FF4E4E" Foreground="White"
                        Margin="110,6,0,-7" x:Name="btnExit" />
                </Grid>
            </TabItem>
            <TabItem Header="Экспортировать отчёт" Background="#FFFF981A">
                <Grid Background="#FF655D90" Margin="-9,0,-2,0" Height="356">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Content="Выберите отчёт:" Foreground="White" Grid.Row="0" Grid.Column="0" Margin="5"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="5" Height="30" x:Name="cbReportsExport"/>
                    <Label Content="Формат:" Foreground="White" Grid.Row="1" Grid.Column="0" Margin="5"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="5" Height="30" x:Name="cbExportFormat">
                        <ComboBoxItem Content="PDF"/>
                        <ComboBoxItem Content="Excel"/>
                    </ComboBox>
                    <Button Content="Экспортировать" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left"
                            Width="122" Background="#FFFF981A" Foreground="White"
                            Margin="5,9,0,-43" x:Name="btnExportReport" Click="btnExportReport_Click"/>
                    <Button Content="Выйти" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left"
                        Width="55" Background="#FF4E4E" Foreground="White"
                        Margin="142,10,0,-43" x:Name="btnExit1"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
