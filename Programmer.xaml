<Window x:Class="pr8.Programmer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr8"
        mc:Ignorable="d"
        Title="Программист – АИСУ «Гига»" Height="450" Width="800" Background="#FF655D90">
    <Grid>
        <Menu VerticalAlignment="Top" Background="#FFFF981A">
            <MenuItem Header="Задачи">
            </MenuItem>
        </Menu>
        <Label Content="Задачи:" HorizontalAlignment="Left" Margin="224,156,0,0" VerticalAlignment="Top" Foreground="White"/>
        <ComboBox HorizontalAlignment="Center" VerticalContentAlignment="Center" FontSize="14" Margin="0,158,0,0" VerticalAlignment="Top" Width="220" Height="26"/>
        <Label Content="Статус:" HorizontalAlignment="Left" Margin="224,195,0,0" VerticalAlignment="Top" Foreground="White"/>
        <ComboBox HorizontalAlignment="Center" VerticalContentAlignment="Center" FontSize="14" Margin="0,195,0,0" VerticalAlignment="Top" Width="220" Height="26"/>
        <Button x:Name="btnConfirm" Content="Подтвердить" HorizontalAlignment="Center" Margin="0,253,0,0" VerticalAlignment="Top" Width="88" Background="#FFFF981A" Height="31" Foreground="#FFFBFBFB"/>
        <Button x:Name="btnExit" Content="Выйти" HorizontalAlignment="Center" Margin="0,297,0,0" VerticalAlignment="Top" Width="88" Background="#FF4E4E" Height="32" Foreground="White"/>
    </Grid>
</Window>
